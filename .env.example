# Defaults — the admin page (⚙️) overrides them.
# Provider: gemini | anthropic | openai | openrouter | compatible
#           | fake (canned cards whatever the photo: tests and development only)
CARTABLE_LLM=gemini
GEMINI_API_KEY=
# CARTABLE_MODEL=gemini-3.8-flash
# Tried in order when the main model stays overloaded (empty = disabled)
# CARTABLE_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# For Claude:
# CARTABLE_LLM=anthropic
# ANTHROPIC_API_KEY=
# CARTABLE_MODEL=claude-opus-5

# For OpenAI (GPT):
# CARTABLE_LLM=openai
# OPENAI_API_KEY=

# For OpenRouter (one key for Gemini, Claude, GPT… default model: the latest Gemini Flash):
# CARTABLE_LLM=openrouter
# OPENROUTER_API_KEY=

# For another OpenAI-compatible service (Ollama, LM Studio, Mistral…):
# CARTABLE_LLM=compatible
# CARTABLE_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# CARTABLE_COMPATIBLE_API_KEY=
# CARTABLE_MODEL=qwen2.5vl

# Where prompts, lessons (photos, cards, audio) and caches are stored
# CARTABLE_DATA=data

# AnkiConnect (Anki desktop add-on) for direct send
# CARTABLE_ANKICONNECT_URL=http://localhost:8765
# CARTABLE_ANKICONNECT_KEY=

# Address phones use, put in their QR code (⚙️ → Phones) when Cartable can't see it:
# Docker, a proxy such as `tailscale serve`.
# CARTABLE_PUBLIC_URL=http://192.168.1.10:8000
