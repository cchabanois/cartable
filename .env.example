# Defaults — the admin page (⚙️) overrides them.
# Provider: gemini | anthropic | openai | fake (canned cards whatever the photo: tests and development only)
CARTABLE_LLM=gemini
GEMINI_API_KEY=
# CARTABLE_MODEL=gemini-3.8-flash
# Tried in order when the main model stays overloaded (empty = disabled)
# CARTABLE_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# For Claude:
# CARTABLE_LLM=anthropic
# ANTHROPIC_API_KEY=
# CARTABLE_MODEL=claude-opus-5

# For OpenAI, OpenRouter or any OpenAI-compatible API:
# CARTABLE_LLM=openai
# CARTABLE_OPENAI_BASE_URL=https://api.openai.com/v1
# CARTABLE_OPENAI_API_KEY=ollama
# CARTABLE_MODEL=qwen2.5vl

# Where prompts, lessons (photos, cards, audio) and caches are stored
# CARTABLE_DATA=data

# AnkiConnect (Anki desktop add-on) for direct send
# CARTABLE_ANKICONNECT_URL=http://localhost:8765
# CARTABLE_ANKICONNECT_KEY=
